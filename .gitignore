# --- Project-specific ---------------------------------------------------------

# Source Word documents and their auto-generated Markdown counterparts.
# The .docx files are the editable originals; the .md is regenerated by
# scripts/docx_to_md.py and shouldn't be tracked.
*.docx
docs/project-summary.md
docs/tech-spec.md

# --- OS / editor cruft --------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
!.vscode/extensions.json

# --- Logs / runtime -----------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Dependencies (placeholder for future apps/packages) ----------------------
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.pyc
Cargo.lock

# --- Build output -------------------------------------------------------------
dist/
build/
out/
.cache/
target/
apps/web/dist/
apps/web/.vite/
# packages/rust/aetrain-routing-wasm/pkg/ is intentionally tracked —
# Cloudflare Pages doesn't have a Rust toolchain in its build env, so
# we ship the wasm-pack output with the source. Rebuild locally via
# `wasm-pack build packages/rust/aetrain-routing-wasm --target web --release`
# and commit the regenerated pkg/* whenever the routing crate changes.
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
data/cache/
data/build/
.playwright-mcp/
output/playwright/
